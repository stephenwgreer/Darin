# Darin Audio Assistant - Environment Variables Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# Flask Configuration
FLASK_APP=app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-here-use-python-secrets-token-hex

# Database
DATABASE_URL=postgres://username:password@host:5432/database

# AI/ML API Keys
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-api03-your-anthropic-key-here

# Speech/Audio APIs
ASSEMBLYAI_KEY=your-assemblyai-key-here
DEEPGRAM_API_KEY=your-deepgram-key-here
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# Twilio (if using phone features)
TWILIO_ACCT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Google Cloud
GOOGLE_APPLICATION_CREDENTIALS=path/to/your-service-account.json
GOOGLE_API_KEY=your-google-api-key-here
