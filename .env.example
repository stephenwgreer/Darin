# Darin Audio Assistant - Environment Configuration
#
# SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. Fill in your actual API keys below
# 3. Never commit .env to version control (already in .gitignore)

# ============================================================================
# REQUIRED API KEYS
# ============================================================================

# Anthropic API Key (for Claude AI analysis)
# Get your key from: https://console.anthropic.com/
# Format: sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Deepgram API Key (for audio transcription)
# Get your key from: https://console.deepgram.com/
# Format: hexadecimal string (40 characters)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ============================================================================
# OPTIONAL: Flask Web Interface Configuration
# ============================================================================
# Uncomment these lines if you're running the web interface

# FLASK_APP=app
# FLASK_ENV=development
# FLASK_DEBUG=1
# SECRET_KEY=your_randomly_generated_secret_key_here

# ============================================================================
# NOTES
# ============================================================================
# - The application validates API keys at startup
# - Missing or empty keys will show a clear error dialog
# - Keys must not be empty or whitespace-only
# - For security, rotate your API keys periodically
