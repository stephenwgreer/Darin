/* Darin Audio Assistant - Dark Theme Stylesheet */

/* Main Window */
QMainWindow {
    background-color: transparent;
}

QWidget#mainWidget {
    background-color: #1E1E1E;
    border-radius: 8px;
}

QWidget {
    background-color: #252526;
    color: #CCCCCC;
    font-family: "Space Grotesk", Arial, sans-serif;
    font-size: 14px;
}

/* Custom Title Bar */
QWidget#titleBar {
    background-color: #1E1E1E;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom: 1px solid #454545;
}

QLabel#titleBarLabel {
    color: #CCCCCC;
    font-size: 14px;
    font-weight: 600;
    background-color: transparent;
}

QPushButton#minimizeButton,
QPushButton#maximizeButton,
QPushButton#closeButton {
    background-color: transparent;
    color: #CCCCCC;
    border: none;
    border-radius: 4px;
    font-size: 18px;
    font-weight: 300;
}

QPushButton#minimizeButton:hover,
QPushButton#maximizeButton:hover {
    background-color: #37373D;
}

QPushButton#closeButton:hover {
    background-color: #E81123;
    color: #FFFFFF;
}

/* Buttons */
QPushButton {
    background-color: #2D2D2D;
    color: #CCCCCC;
    border: 1px solid #454545;
    border-radius: 4px;
    padding: 8px 16px;
    font-size: 12px;
    min-height: 24px;
}

QPushButton:hover {
    background-color: #37373D;
    border-color: #007ACC;
}

QPushButton:pressed {
    background-color: #094771;
}

QPushButton:disabled {
    background-color: #2D2D2D;
    color: #6E6E6E;
    border-color: #3E3E3E;
}

/* Primary Action Button (Record) */
QPushButton#recordButton {
    background-color: #007ACC;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#recordButton:hover {
    background-color: #0098FF;
}

QPushButton#recordButton:pressed {
    background-color: #005A9E;
}

/* Danger Button (Clear) */
QPushButton#clearButton {
    background-color: #5A1D1D;
    color: #F48771;
    border: 1px solid #892929;
}

QPushButton#clearButton:hover {
    background-color: #892929;
    color: #FFFFFF;
}

QPushButton#clearButton:pressed {
    background-color: #A03232;
}

/* Labels */
QLabel {
    background-color: transparent;
    color: #CCCCCC;
}

QLabel#sectionLabel {
    font-size: 14px;
    font-weight: 600;
    color: #FFFFFF;
    padding: 4px 0px;
}

QLabel#timestampLabel {
    color: #9D9D9D;
    font-size: 12px;
}

QLabel#footerLabel {
    color: #6E6E6E;
    font-size: 11px;
}

/* Splitter */
QSplitter::handle {
    background-color: #454545;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #007ACC;
}

/* Menu */
QMenu {
    background-color: #252526;
    border: 1px solid #454545;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px;
    border-radius: 2px;
    background-color: transparent;
}

QMenu::item:selected {
    background-color: #094771;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #6E6E6E;
}

QMenu::separator {
    height: 1px;
    background-color: #454545;
    margin: 4px 0px;
}

/* Scroll Bars */
QScrollBar:vertical {
    background-color: #1E1E1E;
    width: 12px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #454545;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #007ACC;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1E1E1E;
    height: 12px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #454545;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #007ACC;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
}
